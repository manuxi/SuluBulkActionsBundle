{
    "name": "manuxi/sulu-bulk-actions-bundle",
    "description": "Bulk actions (publish, unpublish, delete) for lists in the Sulu admin.",
    "type": "symfony-bundle",
    "homepage": "https://github.com/manuxi/SuluBulkActionsBundle",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "sulu/sulu": "^3.0",
        "symfony/config": "^6.4 | ^7.0",
        "symfony/dependency-injection": "^6.4 | ^7.0",
        "symfony/framework-bundle": "^6.4 | ^7.0",
        "symfony/http-foundation": "^6.4 | ^7.0",
        "symfony/http-kernel": "^6.4 | ^7.0",
        "symfony/messenger": "^6.4 | ^7.0",
        "symfony/translation": "^6.4 | ^7.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "phpunit/phpunit": "^10.5 | ^11.0",
        "symfony/var-exporter": "^6.4 | ^7.0"
    },
    "autoload": {
        "psr-4": {
            "Manuxi\\SuluBulkActionsBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manuxi\\SuluBulkActionsBundle\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": [
            "@phpunit"
        ],
        "phpunit": "vendor/bin/phpunit"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true
        }
    }
}
