<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services
                               https://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="sulu_bulk_actions.handler_registry"
                 class="Manuxi\SuluBulkActionsBundle\Handler\BulkActionHandlerRegistry"/>

        <service id="Manuxi\SuluBulkActionsBundle\Controller\Admin\BulkActionController" public="true">
            <argument type="service" id="sulu_bulk_actions.handler_registry"/>
            <argument type="service" id="sulu_security.security_checker"/>
            <argument>%sulu_bulk_actions.delete_enabled%</argument>

            <tag name="controller.service_arguments"/>
            <tag name="sulu.context" context="admin"/>
        </service>

        <service id="Manuxi\SuluBulkActionsBundle\Admin\BulkActionsAdmin">
            <argument type="service" id="sulu_security.security_checker"/>
            <argument>%sulu_bulk_actions.resources%</argument>
            <argument>%sulu_bulk_actions.delete_enabled%</argument>

            <tag name="sulu.admin"/>
            <tag name="sulu.context" context="admin"/>
        </service>
    </services>
</container>
